{
  "id": "example-video-plugin",
  "name": "Example Video Provider",
  "version": "0.1.0",
  "type": "video-provider",
  "runtime": "node",
  "entry": "backend/index.mjs",
  "models": ["example-video"],
  "capabilities": [
    "validateAccount",
    "estimateCost",
    "submitTask",
    "pollTask",
    "fetchArtifacts"
  ],
  "permissions": {
    "network": ["https://provider.example"],
    "filesystem": ["data", "downloads"],
    "browserProfile": false,
    "secrets": ["providerApiKey"]
  },
  "accountSchema": {
    "type": "object",
    "required": ["label"],
    "properties": {
      "label": { "type": "string" },
      "email": { "type": "string" },
      "creditBalance": { "type": "number" }
    }
  },
  "taskSchema": {
    "type": "object",
    "required": ["prompt"],
    "properties": {
      "prompt": { "type": "string" },
      "duration": { "type": "number" },
      "aspectRatio": { "type": "string" }
    }
  }
}
